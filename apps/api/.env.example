# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="VP Dietetic Center API"

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vp_user:vp_password@localhost:5432/vp_dietetic

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=10h

# ─── Frontend ────────────────────────────────────────────────────────────────
# Public address of the app, used in emails (the API is served under it, at /api)
APP_URL=http://localhost:5173

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vp-dietetic.fr

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Google Cloud Storage ────────────────────────────────────────────────────
# Empty: documents are stored in apps/api/.uploads (development only)
GCS_BUCKET_NAME=

# ─── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
