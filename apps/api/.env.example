# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vp_user:vp_password@localhost:5432/vp_dietetic

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=10h

# ─── Sign-in ─────────────────────────────────────────────────────────────────
# Google is the only way to sign in: the OAuth client ID (same as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Local development and end-to-end tests only: "Connexion de développement" on the sign-in page,
# with the e-mail of a registered account and no Google. The API refuses to start with it
# outside NODE_ENV=development/test or on Cloud Run.
DEV_LOGIN=true

# ─── Google Cloud Storage ────────────────────────────────────────────────────
# Empty: documents are stored in apps/api/.uploads (development only)
GCS_BUCKET_NAME=

# ─── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
