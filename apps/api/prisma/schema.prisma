generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PRATICIENNE
  ASSISTANTE
}

/// Appearance chosen in the settings. SYSTEM follows the device (light or dark).
enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Sex {
  F
  M
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  PHONE
}

/// How a session was paid. NONE = not paid ("Non réglé").
enum PaymentMethod {
  CASH
  CHECK
  CARD
  TRANSFER
  NONE
}

/// Sections of the medical file, in the practitioner's order. Each one keeps its history;
/// the latest entry is the current value.
enum FileField {
  HEALTH // Santé, maladies
  FAMILY_HISTORY // Antécédents familiaux
  PSYCHOLOGY // Psy
  PHYSICAL_ACTIVITY // Activité physique et sportive
  WEIGHT_HISTORY // Histoire du poids et régimes
  ALLERGIES // Allergies
  BLOOD_GLUCOSE // Glycémie
  CHOLESTEROL_TRIGLYCERIDES // Cholestérol et triglycérides
  AVERSIONS // Aversions
  TASTES // Goûts
}

/// What can be measured. Units: kg (WEIGHT, MUSCLE_MASS), cm (HEIGHT, WAIST, HIP), % (BODY_FAT).
/// BMI and basal metabolic rate are computed, never stored.
enum MetricType {
  WEIGHT
  HEIGHT
  WAIST
  HIP
  BODY_FAT
  MUSCLE_MASS
}

enum LifeEventCategory {
  HEALTH // Santé (blessure, maladie, opération)
  TREATMENT // Traitement (début / arrêt d'un médicament)
  FAMILY // Famille, couple
  WORK // Travail, études
  HOME // Déménagement, logement
  OTHER
}

/// INVOICE: "facture" (2026-0001). CREDIT_NOTE: "avoir" (A-2026-0001), cancels an invoice.
enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

/// Who an invoice is addressed to (lot 16): the patient (one session) or a payer (a period).
enum InvoiceRecipient {
  PATIENT
  PAYER
}

/// A discount or a coverage: an amount in cents, or a percentage (0–100).
enum ShareKind {
  AMOUNT
  PERCENT
}

/// How often a payer is billed (lot 16).
enum BillingRhythm {
  MONTHLY
  /// Every N months (Payer.rhythmMonths)
  EVERY_N_MONTHS
  ON_DEMAND
}

enum GpReportStatus {
  DRAFT
  SENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentType {
  ANALYSIS
  PRESCRIPTION
  REPORT
  CONSENT
  OTHER
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(uuid()) @map("id")
  /// Address of the Google account used to sign in (the only way to sign in)
  email       String    @unique
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String?
  role        UserRole  @default(ASSISTANTE)
  googleId    String?   @unique @map("google_id")
  avatarUrl   String?   @map("avatar_url")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Two-step verification (TOTP, mandatory after Google): base32 secret, set at enrolment
  twoFactorSecret        String?   @map("two_factor_secret")
  /// When enrolment was confirmed with a first code; null = enrolment still to do
  twoFactorEnabledAt     DateTime? @map("two_factor_enabled_at")
  /// Last 30-second step accepted: a code is never accepted twice
  twoFactorLastStep      Int?      @map("two_factor_last_step")
  /// SHA-256 of the unused recovery codes
  twoFactorRecoveryCodes String[]  @default([]) @map("two_factor_recovery_codes")

  // Relations
  preferences   UserPreferences?
  practice      PractitionerProfile?
  refreshTokens RefreshToken[]
  patients      Patient[]            @relation("PractitionerPatients")
  appointments  Appointment[]        @relation("PractitionerAppointments")
  consultations Consultation[]       @relation("PractitionerConsultations")
  documents     Document[]           @relation("UploaderDocuments")
  tasks         Task[]               @relation("AssignedTasks")
  auditLogs     AuditLog[]
  formulas      Formula[]
  practices     Practice[]
  gpReports     GpReport[]           @relation("AuthorGpReports")
  invoices      Invoice[]            @relation("PractitionerInvoices")
  payers        Payer[]

  @@map("user")
}

model UserPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  theme     Theme    @default(SYSTEM)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// The practitioner's activity, printed on her invoices (lot 5): who she is, not where she
/// consults (her practices, below, hold the addresses). Edited in Paramètres > Mon activité.
model PractitionerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  /// Name printed on the invoices ("Valérie Pera, diététicienne")
  practiceName  String?  @map("practice_name")
  /// 14 digits, Luhn checked. A practice may have its own (Practice.siret).
  siret         String?
  /// ADELI (9 digits) or RPPS (11 digits)
  adeliRpps     String?  @map("adeli_rpps")
  /// VAT mention, typed by the practitioner (e.g. "TVA non applicable, art. 261-4-1° du CGI")
  vatMention    String?  @map("vat_mention") @db.Text
  /// Free text at the bottom of the invoices
  invoiceFooter String?  @map("invoice_footer") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("practitioner_profile")
}

/// A place where the practitioner consults (lot 15). Each practitioner has at least one active
/// practice and exactly one default among them (rule kept by PracticesService). Its address,
/// and its SIRET when it has its own, are printed on the invoices of its sessions.
model Practice {
  id             String    @id @default(uuid())
  practitionerId String    @map("practitioner_id")
  name           String
  /// Number and street
  address        String?
  zipCode        String?   @map("zip_code")
  city           String?
  phone          String?
  /// Only when it differs from the activity's (PractitionerProfile.siret)
  siret          String?
  isDefault      Boolean   @default(false) @map("is_default")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  practitioner  User           @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  consultations Consultation[]

  @@index([practitionerId])
  @@map("practice")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id                 String    @id @default(uuid())
  practitionerId     String    @map("practitioner_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  sex                Sex?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  /// Only the age was known: dateOfBirth is January 1st of the estimated birth year.
  birthDateEstimated Boolean   @default(false) @map("birth_date_estimated")
  email              String?
  phone              String?
  address            String?
  city               String?
  zipCode            String?   @map("zip_code")
  familySituation    String?   @map("family_situation") @db.Text
  profession         String?
  gpName             String?   @map("gp_name") // Médecin traitant

  consultationReason String? @map("consultation_reason") @db.Text // Motif
  referralSource     String? @map("referral_source") // Adressé par

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  practitioner  User              @relation("PractitionerPatients", fields: [practitionerId], references: [id])
  appointments  Appointment[]
  consultations Consultation[]
  measurements  Measurement[]
  fileEntries   FileEntry[]
  lifeEvents    LifeEvent[]
  gpReports     GpReport[]
  documents     Document[]
  tasks         Task[]
  consents      Consent[]
  invoices      Invoice[]
  coverages     PatientCoverage[]

  @@map("patient")
}

model Consent {
  id        String    @id @default(uuid())
  patientId String    @map("patient_id")
  type      String // "data_processing", "health_data", "communication"
  version   String    @default("1.0")
  givenAt   DateTime  @map("given_at")
  revokedAt DateTime? @map("revoked_at")
  evidence  String?   @db.Text // Texte signé ou référence document
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("consent")
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(uuid())
  patientId      String            @map("patient_id")
  practitionerId String            @map("practitioner_id")
  startAt        DateTime          @map("start_at")
  endAt          DateTime          @map("end_at")
  duration       Int // minutes
  type           AppointmentType   @default(IN_PERSON)
  status         AppointmentStatus @default(SCHEDULED)
  /// Type of appointment: one of her formulas, which also gives the duration (lot 15)
  formulaId      String?           @map("formula_id")
  /// Where it takes place; null for a video or phone appointment
  practiceId     String?           @map("practice_id")
  /// Optional note (it used to be the free-text reason)
  reason         String?           @db.Text
  cancelReason   String?           @map("cancel_reason")
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  practitioner User          @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  formula      Formula?      @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  practice     Practice?     @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  consultation Consultation?
  tasks        Task[]

  @@index([patientId])
  @@index([practitionerId])
  @@index([startAt])
  @@map("appointment")
}

// ─── Patient file ─────────────────────────────────────────────────────────────

/// A price of the practice ("Bilan 60 €, 1 h", "Suivi 50 €, 45 min"), which is also a type of
/// appointment (lot 15). Managed in the settings (lot 3); sessions keep a copy of its label and
/// price.
model Formula {
  id              String    @id @default(uuid())
  practitionerId  String    @map("practitioner_id")
  label           String
  priceCents      Int?      @map("price_cents")
  /// Duration of an appointment of this type
  durationMinutes Int       @default(45) @map("duration_minutes")
  firstAppointment Boolean  @default(false) @map("first_appointment")
  position        Int       @default(0)
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  practitioner  User           @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  consultations Consultation[]
  appointments  Appointment[]

  @@index([practitionerId, position])
  @@map("formula")
}

/// One session with the patient: a row of the practitioner's follow-up sheet. Never locked.
/// Its weight is a WEIGHT measurement linked to it.
model Consultation {
  id             String        @id @default(uuid())
  patientId      String        @map("patient_id")
  practitionerId String        @map("practitioner_id")
  appointmentId  String?       @unique @map("appointment_id")
  date           DateTime
  formulaId      String?       @map("formula_id")
  formulaLabel   String?       @map("formula_label") // copy at the time of the session
  priceCents     Int?          @map("price_cents") // copy at the time of the session
  paymentMethod  PaymentMethod @default(NONE) @map("payment_method")
  /// Where it took place: its address is printed on the invoice
  practiceId     String?       @map("practice_id")

  // Discount (« remise », lot 16): in cents or in %, prefilled from the patient's previous session
  discountKind   ShareKind? @map("discount_kind")
  /// Cents (AMOUNT) or percent (PERCENT)
  discountValue  Int?       @map("discount_value")
  discountReason String?    @map("discount_reason")

  // The split of the price (lot 16), computed when the session's price, discount or date change
  // and then kept: a later change of the patient's coverage leaves it alone. Null without a
  // price. net = price - discount = payer part + patient part.
  discountCents Int?    @map("discount_cents")
  netCents      Int?    @map("net_cents")
  payerOverrideCents Int? @map("payer_override_cents")
  payerCents    Int?    @map("payer_cents")
  patientCents  Int?    @map("patient_cents")
  /// The payer of the payer part, and the coverage it came from
  payerId       String? @map("payer_id")
  coverageId    String? @map("coverage_id")

  habits      String?  @db.Text // Habitudes et évolution
  sessionWork String?  @map("session_work") @db.Text // Travail en consultation
  advice      String?  @db.Text // Conseils diététiques
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  patient      Patient          @relation(fields: [patientId], references: [id])
  practitioner User             @relation("PractitionerConsultations", fields: [practitionerId], references: [id])
  appointment  Appointment?     @relation(fields: [appointmentId], references: [id])
  formula      Formula?         @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  practice     Practice?        @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  payer        Payer?           @relation(fields: [payerId], references: [id], onDelete: SetNull)
  coverage     PatientCoverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  measurements Measurement[]
  fileEntries  FileEntry[]
  lifeEvents   LifeEvent[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]

  @@index([patientId, date])
  @@index([payerId, date])
  @@map("consultation")
}

model Measurement {
  id             String     @id @default(uuid())
  patientId      String     @map("patient_id")
  consultationId String?    @map("consultation_id")
  type           MetricType
  value          Decimal    @db.Decimal(6, 2)
  measuredAt     DateTime   @map("measured_at") @db.Date
  note           String?
  createdAt      DateTime   @default(now()) @map("created_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId, type, measuredAt])
  @@map("measurement")
}

/// One version of a section of the medical file. Editing a section the same day (or in the
/// same session) updates that entry; editing it another day adds a new version.
model FileEntry {
  id             String    @id @default(uuid())
  patientId      String    @map("patient_id")
  consultationId String?   @map("consultation_id")
  field          FileField
  content        String    @db.Text
  date           DateTime  @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId, field, date])
  @@map("file_entry")
}

/// Something that happened in the patient's life, shown on the weight chart.
model LifeEvent {
  id             String             @id @default(uuid())
  patientId      String             @map("patient_id")
  consultationId String?            @map("consultation_id")
  date           DateTime           @db.Date
  title          String
  category       LifeEventCategory?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId, date])
  @@map("life_event")
}

/// A report to the patient's general practitioner ("compte rendu au médecin").
model GpReport {
  id        String         @id @default(uuid())
  patientId String         @map("patient_id")
  authorId  String         @map("author_id")
  date      DateTime       @db.Date
  content   String         @db.Text
  status    GpReportStatus @default(DRAFT)
  sentAt    DateTime?      @map("sent_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  User    @relation("AuthorGpReports", fields: [authorId], references: [id])

  @@index([patientId, date])
  @@map("gp_report")
}

// ─── Payers (« tiers payant », lot 16) ───────────────────────────────────────

/// An organisation that pays all or part of some patients' sessions (mutuelle, employer,
/// association, convention…). Managed in the « Organismes » tab of the Factures page, billed by
/// period with one invoice grouping its sessions.
model Payer {
  id                  String        @id @default(uuid())
  practitionerId      String        @map("practitioner_id")
  name                String
  /// Number and street
  address             String?
  zipCode             String?       @map("zip_code")
  city                String?
  /// Who to write to: a person, an e-mail, a phone
  contact             String?
  conventionReference String?       @map("convention_reference")
  billingRhythm       BillingRhythm @default(MONTHLY) @map("billing_rhythm")
  /// EVERY_N_MONTHS only: N (2 to 12)
  rhythmMonths        Int?          @map("rhythm_months")
  notes               String?       @db.Text
  archivedAt          DateTime?     @map("archived_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  practitioner  User              @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  coverages     PatientCoverage[]
  consultations Consultation[]
  invoices      Invoice[]

  @@index([practitionerId])
  @@map("payer")
}

/// What a payer covers for a patient, per session: an amount or a percentage of the net price,
/// for a number of sessions and a period when they are limited.
model PatientCoverage {
  id             String    @id @default(uuid())
  patientId      String    @map("patient_id")
  payerId        String    @map("payer_id")
  kind           ShareKind
  /// Cents (AMOUNT) or percent (PERCENT) of the net price of each session
  value          Int
  /// Covered sessions at most (the sessions with a payer part count)
  maxSessions    Int?      @map("max_sessions")
  /// Paris days, both included
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  /// « Numéro de prise en charge »
  coverageNumber String?   @map("coverage_number")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payer         Payer          @relation(fields: [payerId], references: [id], onDelete: Restrict)
  consultations Consultation[]

  @@index([patientId])
  @@index([payerId])
  @@map("patient_coverage")
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

/// An invoice or a credit note (docs/REFONTE.md lot 5). Issued only when the practitioner asks,
/// never changed nor deleted afterwards (legal rule): a mistake is cancelled by a credit note,
/// then a new invoice replaces it. It keeps a copy of the practice, the patient and the session
/// at the time of issue, so deleting the session or the patient leaves it whole (kept 10 years).
model Invoice {
  id             String           @id @default(uuid())
  practitionerId String           @map("practitioner_id")
  /// Null once the patient is erased: the copies below remain
  patientId      String?          @map("patient_id")
  /// Null once the session is deleted
  consultationId String?          @map("consultation_id")
  type           InvoiceType
  /// The patient (one session) or a payer (its sessions over a period). One series for both.
  recipient      InvoiceRecipient @default(PATIENT)
  /// Payer invoices: the payer billed (null once it is deleted; the copies remain)
  payerId        String?          @map("payer_id")
  /// Numbering: continuous per practitioner, per year (Europe/Paris) and per type, without gaps
  year           Int
  sequence       Int
  /// "2026-0001" (invoice) or "A-2026-0001" (credit note)
  number         String
  issuedAt       DateTime         @map("issued_at")
  /// Negative for a credit note. Patient invoices: the patient part of the session.
  amountCents    Int              @map("amount_cents")
  /// Payer invoices: NONE (their payment is followed with paidAt)
  paymentMethod  PaymentMethod    @map("payment_method")

  // The service, copied from the session (payer invoices: « Prise en charge », end of the period)
  serviceLabel String   @map("service_label")
  serviceDate  DateTime @map("service_date")

  // Patient invoices (lot 16): price, discount and payer part, copied from the session's split.
  // Null on invoices issued before.
  priceCents     Int?    @map("price_cents")
  discountCents  Int?    @map("discount_cents")
  discountReason String? @map("discount_reason")
  payerCents     Int?    @map("payer_cents")
  /// Patient invoices: the payer of the payer part. Payer invoices: the payer billed.
  payerName      String? @map("payer_name")

  // Payer invoices: the payer, copied at issue, and the period billed (Paris days, included)
  payerAddress        String?   @map("payer_address")
  payerZipCode        String?   @map("payer_zip_code")
  payerCity           String?   @map("payer_city")
  payerContact        String?   @map("payer_contact")
  conventionReference String?   @map("convention_reference")
  periodStart         DateTime? @map("period_start") @db.Date
  periodEnd           DateTime? @map("period_end") @db.Date
  /// Payer invoices: « réglée le … » (null: « en attente »). Set after issue.
  paidAt              DateTime? @map("paid_at") @db.Date

  // The practice, copied at issue: the activity (name, numbers, mentions), and the address of
  // the session's practice (with its SIRET when it has its own)
  practiceName    String  @map("practice_name")
  practiceAddress String? @map("practice_address")
  practiceZipCode String? @map("practice_zip_code")
  practiceCity    String? @map("practice_city")
  siret           String?
  adeliRpps       String? @map("adeli_rpps")
  vatMention      String? @map("vat_mention") @db.Text
  invoiceFooter   String? @map("invoice_footer") @db.Text

  // The patient, copied from the file (null on payer invoices)
  patientFirstName String? @map("patient_first_name")
  patientLastName  String? @map("patient_last_name")
  patientAddress   String? @map("patient_address")
  patientZipCode   String? @map("patient_zip_code")
  patientCity      String? @map("patient_city")

  /// Invoices only: set when a credit note cancels it
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")
  /// Invoices only: the credit note that cancels it
  creditNoteId String?   @unique @map("credit_note_id")
  /// Invoices only: the invoice issued in its place ("remplace la n° 2026-0012")
  replacedById String?   @unique @map("replaced_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  practitioner User          @relation("PractitionerInvoices", fields: [practitionerId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  payer        Payer?        @relation(fields: [payerId], references: [id], onDelete: SetNull)
  /// Payer invoices (and their credit notes): one line per session
  lines        InvoiceLine[]
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  creditNote   Invoice?      @relation("InvoiceCreditNote", fields: [creditNoteId], references: [id])
  /// Credit notes only: the invoice it cancels
  cancels      Invoice?      @relation("InvoiceCreditNote")
  replacedBy   Invoice?      @relation("InvoiceReplacement", fields: [replacedById], references: [id])
  /// The invoice this one replaces
  replaces     Invoice?      @relation("InvoiceReplacement")

  @@unique([practitionerId, type, year, sequence])
  @@unique([practitionerId, number])
  @@index([practitionerId, issuedAt])
  @@index([patientId])
  @@index([consultationId])
  @@index([payerId])
  @@map("invoice")
}

/// One session of a payer invoice (or of its credit note, in negative): copies only, nothing
/// medical. Never changed nor deleted (database guard), except its link to a deleted session.
model InvoiceLine {
  id               String   @id @default(uuid())
  invoiceId        String   @map("invoice_id")
  /// Null once the session is deleted
  consultationId   String?  @map("consultation_id")
  position         Int
  serviceDate      DateTime @map("service_date")
  serviceLabel     String   @map("service_label")
  patientFirstName String   @map("patient_first_name")
  patientLastName  String   @map("patient_last_name")
  coverageNumber   String?  @map("coverage_number")
  /// The payer part of the session (negative on a credit note)
  amountCents      Int      @map("amount_cents")

  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
  @@index([consultationId])
  @@map("invoice_line")
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id           String       @id @default(uuid())
  patientId    String       @map("patient_id")
  uploadedById String       @map("uploaded_by_id")
  name         String
  originalName String       @map("original_name")
  type         DocumentType @default(OTHER)
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  gcsPath      String       @map("gcs_path") // Path dans Cloud Storage
  description  String?      @db.Text
  deletedAt    DateTime?    @map("deleted_at") // Soft delete
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User    @relation("UploaderDocuments", fields: [uploadedById], references: [id])

  @@index([patientId])
  @@map("document")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?      @db.Text
  patientId     String?      @map("patient_id")
  appointmentId String?      @map("appointment_id")
  assignedToId  String?      @map("assigned_to_id")
  createdById   String       @map("created_by_id")
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(MEDIUM)
  dueAt         DateTime?    @map("due_at")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  patient     Patient?     @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  assignedTo  User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([patientId])
  @@index([assignedToId])
  @@index([dueAt])
  @@map("task")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  action    AuditAction
  entity    String // "patient", "consultation", "measurement", "document", "user", "session"…
  entityId  String?     @map("entity_id")
  /// Patient whose data was read or changed. No foreign key: the trail outlives the patient.
  patientId String?     @map("patient_id")
  metadata  Json? // Context only (route, status); never clinical content
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([patientId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
