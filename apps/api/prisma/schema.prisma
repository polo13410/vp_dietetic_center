generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PRATICIENNE
  ASSISTANTE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  PHONE
}

enum ConsultationStatus {
  DRAFT
  FINALIZED
}

/// Themes of the patient's file. Each one keeps its history; the latest entry is the current state.
enum PatientTopic {
  EATING // Alimentation
  ACTIVITY // Activité physique
  SLEEP // Sommeil
  EMOTIONS // Stress & émotions
  DIGESTION // Digestion & transit
  HEALTH // Santé & traitements
  LIFE // Contexte de vie
}

/// What can be measured. Units: kg (WEIGHT, MUSCLE_MASS), cm (HEIGHT, WAIST, HIP), % (BODY_FAT),
/// 1-10 scales (ENERGY, SLEEP_QUALITY, STRESS, HUNGER). BMI is computed, never stored.
enum MetricType {
  WEIGHT
  HEIGHT
  WAIST
  HIP
  BODY_FAT
  MUSCLE_MASS
  ENERGY
  SLEEP_QUALITY
  STRESS
  HUNGER
}

enum LifeEventCategory {
  HEALTH // Santé (blessure, maladie, opération)
  TREATMENT // Traitement (début / arrêt d'un médicament)
  FAMILY // Famille, couple
  WORK // Travail, études
  HOME // Déménagement, logement
  OTHER
}

enum GoalStatus {
  IN_PROGRESS
  ACHIEVED
  PARTIAL
  ABANDONED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentType {
  ANALYSIS
  PRESCRIPTION
  REPORT
  CONSENT
  OTHER
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  FINALIZE
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(uuid()) @map("id")
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  role                   UserRole  @default(ASSISTANTE)
  googleId               String?   @unique @map("google_id")
  avatarUrl              String?   @map("avatar_url")
  isActive               Boolean   @default(true) @map("is_active")
  lastLoginAt            DateTime? @map("last_login_at")
  loginAttempts          Int       @default(0) @map("login_attempts")
  lockedUntil            DateTime? @map("locked_until")
  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  preferences   UserPreferences?
  refreshTokens RefreshToken[]
  patients      Patient[]        @relation("PractitionerPatients")
  appointments  Appointment[]    @relation("PractitionerAppointments")
  consultations Consultation[]   @relation("PractitionerConsultations")
  documents     Document[]       @relation("UploaderDocuments")
  tasks         Task[]           @relation("AssignedTasks")
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("user")
}

model UserPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  language           String   @default("fr")
  timezone           String   @default("Europe/Paris")
  defaultView        String   @default("day") @map("default_view")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id             String        @id @default(uuid())
  practitionerId String        @map("practitioner_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  dateOfBirth    DateTime?     @map("date_of_birth") @db.Date
  email          String?
  phone          String?
  address        String?
  city           String?
  zipCode        String?       @map("zip_code")
  status         PatientStatus @default(ACTIVE)
  privateNote    String?       @map("private_note") @db.Text

  // Profile: why they came, and what must never be missed
  consultationReason  String? @map("consultation_reason") @db.Text
  allergies           String? @db.Text
  dietaryRestrictions String? @map("dietary_restrictions") @db.Text // vegetarian, halal, etc.

  // Emergency contact (stored as JSON)
  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactPhone        String? @map("emergency_contact_phone")
  emergencyContactRelationship String? @map("emergency_contact_relationship")

  // Metadata
  referralSource String?   @map("referral_source")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  practitioner  User           @relation("PractitionerPatients", fields: [practitionerId], references: [id])
  tags          PatientTag[]
  appointments  Appointment[]
  consultations Consultation[]
  measurements  Measurement[]
  topicNotes    TopicNote[]
  lifeEvents    LifeEvent[]
  goals         Goal[]
  documents     Document[]
  tasks         Task[]
  consents      Consent[]

  @@map("patient")
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  color    String       @default("#6366f1")
  patients PatientTag[]

  @@map("tag")
}

model PatientTag {
  patientId String @map("patient_id")
  tagId     String @map("tag_id")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patientId, tagId])
  @@map("patient_tag")
}

model Consent {
  id        String    @id @default(uuid())
  patientId String    @map("patient_id")
  type      String // "data_processing", "health_data", "communication"
  version   String    @default("1.0")
  givenAt   DateTime  @map("given_at")
  revokedAt DateTime? @map("revoked_at")
  evidence  String?   @db.Text // Texte signé ou référence document
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("consent")
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(uuid())
  patientId      String            @map("patient_id")
  practitionerId String            @map("practitioner_id")
  startAt        DateTime          @map("start_at")
  endAt          DateTime          @map("end_at")
  duration       Int // minutes
  type           AppointmentType   @default(IN_PERSON)
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?           @db.Text
  cancelReason   String?           @map("cancel_reason")
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  practitioner User          @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  consultation Consultation?
  tasks        Task[]

  @@index([patientId])
  @@index([practitionerId])
  @@index([startAt])
  @@map("appointment")
}

// ─── Patient file ─────────────────────────────────────────────────────────────

/// One session with the patient (usually from an appointment). Everything recorded during it
/// (measurements, topic updates, events, goals) points back to it.
model Consultation {
  id             String             @id @default(uuid())
  patientId      String             @map("patient_id")
  practitionerId String             @map("practitioner_id")
  appointmentId  String?            @unique @map("appointment_id")
  date           DateTime
  summary        String?            @db.Text // what happened, what was said
  advice         String?            @db.Text // advice and plan given to the patient
  status         ConsultationStatus @default(DRAFT)
  finalizedAt    DateTime?          @map("finalized_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  practitioner User          @relation("PractitionerConsultations", fields: [practitionerId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  measurements Measurement[]
  topicNotes   TopicNote[]
  lifeEvents   LifeEvent[]
  goals        Goal[]        @relation("GoalCreatedIn")
  goalReviews  GoalReview[]

  @@index([patientId, date])
  @@map("consultation")
}

model Measurement {
  id             String     @id @default(uuid())
  patientId      String     @map("patient_id")
  consultationId String?    @map("consultation_id")
  type           MetricType
  value          Decimal    @db.Decimal(6, 2)
  measuredAt     DateTime   @map("measured_at") @db.Date
  note           String?
  createdAt      DateTime   @default(now()) @map("created_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId, type, measuredAt])
  @@map("measurement")
}

/// An update on one topic of the file ("now eats breakfast", "started swimming twice a week").
model TopicNote {
  id             String       @id @default(uuid())
  patientId      String       @map("patient_id")
  consultationId String?      @map("consultation_id")
  topic          PatientTopic
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId, topic, createdAt])
  @@map("topic_note")
}

/// Something that happened in the patient's life, shown on the measurement charts.
model LifeEvent {
  id             String            @id @default(uuid())
  patientId      String            @map("patient_id")
  consultationId String?           @map("consultation_id")
  date           DateTime          @db.Date
  title          String
  description    String?           @db.Text
  category       LifeEventCategory @default(OTHER)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId, date])
  @@map("life_event")
}

/// A goal agreed with the patient, reviewed at each following session.
model Goal {
  id             String     @id @default(uuid())
  patientId      String     @map("patient_id")
  consultationId String?    @map("consultation_id") // session where it was set
  title          String
  details        String?    @db.Text
  status         GoalStatus @default(IN_PROGRESS)
  closedAt       DateTime?  @map("closed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation("GoalCreatedIn", fields: [consultationId], references: [id], onDelete: SetNull)
  reviews      GoalReview[]

  @@index([patientId, status])
  @@map("goal")
}

/// How a goal stood at a given session.
model GoalReview {
  id             String     @id @default(uuid())
  goalId         String     @map("goal_id")
  consultationId String     @map("consultation_id")
  status         GoalStatus
  comment        String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([goalId, consultationId])
  @@map("goal_review")
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id           String       @id @default(uuid())
  patientId    String       @map("patient_id")
  uploadedById String       @map("uploaded_by_id")
  name         String
  originalName String       @map("original_name")
  type         DocumentType @default(OTHER)
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  gcsPath      String       @map("gcs_path") // Path dans Cloud Storage
  description  String?      @db.Text
  deletedAt    DateTime?    @map("deleted_at") // Soft delete
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User    @relation("UploaderDocuments", fields: [uploadedById], references: [id])

  @@index([patientId])
  @@map("document")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?      @db.Text
  patientId     String?      @map("patient_id")
  appointmentId String?      @map("appointment_id")
  assignedToId  String?      @map("assigned_to_id")
  createdById   String       @map("created_by_id")
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(MEDIUM)
  dueAt         DateTime?    @map("due_at")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  patient     Patient?     @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  assignedTo  User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([patientId])
  @@index([assignedToId])
  @@index([dueAt])
  @@map("task")
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  TASK_CREATED
  TASK_DUE
  CONSULTATION_FINALIZED
  PATIENT_CREATED
  SYSTEM
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type") // "appointment", "task", "note", "patient"
  entityId   String?          @map("entity_id")
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notification")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  action    AuditAction
  entity    String // "patient", "appointment", "note", etc.
  entityId  String?     @map("entity_id")
  metadata  Json? // Données supplémentaires (avant/après pour UPDATE)
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
